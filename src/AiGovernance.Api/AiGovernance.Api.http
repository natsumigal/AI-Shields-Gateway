Content-Type: application/json

{
  "prompt": "Summarize safe AI governance practices.",
  "userId": "user-123",
  "tenantId": "tenant-a",
  "purpose": "mock-api-test",
  "correlationId": "sample-allow-001",
  "metadata": {
    "channel": "http-file"
  }
}

