{
  "OutputGuard": {
    "BlockedOutputTerms": [
      "system prompt",
      "developer message",
      "secret key",
      "password"
    ],
    "RedactionPatterns": [
      "\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b",
      "\\b\\d{3}-\\d{2}-\\d{4}\\b",
      "\\b(?:\\d[ -]*?){13,16}\\b"
    ],
    "ReplacementText": "[redacted]"
  }
}
